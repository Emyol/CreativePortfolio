{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "WebFetch(domain:awwwards.com)",
      "WebFetch(domain:www.awwwards.com)",
      "WebFetch(domain:gsap.com)",
      "WebFetch(domain:thefwa.com)",
      "WebFetch(domain:www.cssdesignawards.com)",
      "WebFetch(domain:godly.website)",
      "WebFetch(domain:www.siteinspire.com)",
      "WebFetch(domain:minimal.gallery)",
      "WebFetch(domain:httpster.net)",
      "WebFetch(domain:onepagelove.com)",
      "WebFetch(domain:lenis.darkroom.engineering)",
      "WebFetch(domain:developer.mozilla.org)",
      "WebFetch(domain:reactbits.dev)",
      "WebFetch(domain:motion.dev)",
      "WebFetch(domain:ui.aceternity.com)",
      "WebFetch(domain:magicui.design)",
      "WebFetch(domain:21st.dev)"
    ]
  },
  "extraKnownMarketplaces": {
    "gsap-skills": {
      "source": {
        "source": "github",
        "repo": "greensock/gsap-skills"
      }
    }
  },
  "enabledPlugins": {
    "gsap-skills@gsap-skills": true
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "[ ! -f \"$HOME/.claude/skills/impeccable/scripts/hook.mjs\" ] || node \"$HOME/.claude/skills/impeccable/scripts/hook.mjs\"",
            "timeout": 5,
            "statusMessage": "Checking UI changes"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ ! -f \"$HOME/.claude/skills/impeccable/scripts/hook.mjs\" ] || node \"$HOME/.claude/skills/impeccable/scripts/hook.mjs\"",
            "timeout": 30,
            "statusMessage": "Design deep pass"
          }
        ]
      }
    ]
  }
}
