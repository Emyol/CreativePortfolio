# Supabase project settings > API. The publishable key (or legacy anon key), NEVER the
# service_role key. The tape shares the professional site's project (see docs/admin-setup.md).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
# http://localhost:3000 locally; the site's real origin on Vercel. Also the social card's base URL.
SITE_URL=http://localhost:3000
# A long random string. Vercel Cron sends it to /api/keepalive.
CRON_SECRET=
