# Dependencies
node_modules/
.pnp
.pnp.js

# Next.js
.next/
.next-e2e/
out/
build/
dist/
next-env.d.ts
*.tsbuildinfo

# Environment (never commit; keep .env.example)
.env
.env*.local

# Testing and scratch
coverage/
test-results/
playwright-report/
artifacts/
.superpowers/

# Debug
npm-debug.log*
yarn-debug.log*

# Editors and OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Vercel
.vercel

# Raw material stays local until you choose to publish it
content-inbox/*/*
!content-inbox/*/.gitkeep

# Inspiration screenshots are other people's work: keep local
docs/inspiration/shots/

# Private originals: raw photos you do not want in Git go here
private/

# Playwright MCP scratch (snapshots, console logs)
.playwright-mcp/

# Python bytecode and Blender autosave backups from the render scripts
__pycache__/
*.blend1

# Raw Blender renders; the encoded files in public/device/ are what ships
art/blender/side-a/out/

# Local tool scratch: arena runs and the Impeccable hook's cache
.arena/
.impeccable/
